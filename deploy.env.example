# Required: use the exact digest emitted by the publish job.
TOGETHER_IMAGE=

POSTGRES_DB=together
POSTGRES_USER=together
POSTGRES_PASSWORD=

# Keep 127.0.0.1 when a reverse proxy runs on this host.
# Use 0.0.0.0 only when the application must be reachable directly from the network.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Keep true behind production HTTPS. Use false only for an isolated HTTP test stand.
SECURE_COOKIES=true

# Optional integrations. Keep secrets only in this untracked deployment file or a secret store.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_METRIKA_COUNTER_ID=

# Set only to the exact reverse-proxy IP. Leave empty for direct access.
TRUSTED_PROXY_IP=
# Enable only when the proxy reliably sends X-Forwarded-Proto=https.
USE_HTTPS_REDIRECTION=false
