# Prefer an immutable sha-* or v* tag in production.
TOGETHER_IMAGE=ghcr.io/tipz/ht5:latest

POSTGRES_DB=together
POSTGRES_USER=together
POSTGRES_PASSWORD=together

# Keep 127.0.0.1 when a reverse proxy runs on this host.
# Use 0.0.0.0 only when the application must be reachable directly from the network.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080

# Keep true behind production HTTPS. Use false only for an isolated HTTP test stand.
SECURE_COOKIES=false
